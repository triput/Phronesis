# Phronesis environment template — copy to .env and fill in values (never commit .env)

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — **SQLite is the default** (leave DATABASE_URL unset).
# With PHRONESIS_DATA_DIR (Windows launcher): %LOCALAPPDATA%\Phronesis\db.sqlite3
# Without: ./db.sqlite3 in the repo
# Postgres is opt-in only — uncomment and set when you deliberately want it:
# DATABASE_URL=postgres://user:pass@localhost:5432/phronesis

# Standalone data directory (set by Start-Phronesis.ps1)
# PHRONESIS_DATA_DIR=

# Google Calendar OAuth (optional — prefer Settings → Calendars)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/calendar/oauth2callback/

# Calendar OAuth token encryption at rest (VN-E05 / S-31)
# Optional Fernet key (url-safe base64 32 bytes). If unset, derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PHRONESIS_CREDENTIALS_KEY=
# During key rotation only — old key kept until encrypt_calendar_credentials finishes:
# PHRONESIS_CREDENTIALS_KEY_PREVIOUS=

# Celery / Redis (P5-04) — required for worker + Beat; optional if using cron fallback
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Login lockout (VN-E04 / django-axes) — defaults: 5 failures, 1 hour cool-off
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_HOURS=1

# Email (optional)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Docker Compose (VN-E02 operator-only) — when using --profile postgres:
# DATABASE_URL=postgres://phronesis:phronesis@postgres:5432/phronesis
# When using --profile redis:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# PHRONESIS_HTTP_PORT=8000
